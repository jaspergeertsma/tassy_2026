
---
import Layout from '../layouts/Layout.astro';
import FlightSegment from '../components/FlightSegment.astro';
import flightsData from '../data/flights.json';
import type { Flight } from '../types';

const flights: Flight[] = flightsData as Flight[];
---

<Layout title="Vliegreis | Tasmanië 2026">
  <main class="flights-page">
    <div class="header-section text-center">
      <span class="eyebrow">De Reis</span>
      <h1>Vluchtinformatie</h1>
      <p class="intro">24 uur, 17.000 kilometer. De tocht naar de andere kant van de wereld.</p>
    </div>

    <div class="timeline-container container">
      {flights.length > 0 ? flights.map((trip) => (
        <section class="trip-block scroll-reveal">
          <header class="trip-header">
            <h2 class="trip-title">{trip.direction === 'outbound' ? 'Heenreis (AMS → TAS)' : 'Terugreis (TAS → AMS)'}</h2>
            <div class="divider"></div>
          </header>
          
          <div class="segments-list">
            {trip.segments.map((segment, index) => (
              <FlightSegment segment={segment} isLast={index === trip.segments.length - 1} />
            ))}
          </div>
        </section>
      )) : (
         <div class="empty-state">
           <p>Nog geen vluchten bekend.</p>
         </div>
      )}
    </div>
  </main>
</Layout>

<style>
  .flights-page {
    background-color: var(--color-bg-dark);
    min-height: 100vh;
    padding-bottom: var(--space-xl);
  }

  .header-section {
    padding: var(--space-lg) var(--space-md);
    background-color: #151312; /* Darker header */
    margin-bottom: var(--space-lg);
    border-bottom: 2px solid var(--color-accent-rust);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent-rust);
    display: block;
    margin-bottom: var(--space-xs);
  }

  .intro {
    font-family: var(--font-body);
    font-size: 1.25rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
  }
  
  .timeline-container {
    max-width: 900px;
  }

  .trip-block {
    background-color: var(--color-bg-card);
    padding: var(--space-lg);
    border: 1px solid rgba(255,255,255,0.05);
    margin-bottom: var(--space-xl);
    position: relative;
  }

  .trip-header {
    margin-bottom: var(--space-lg);
    text-align: left;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: var(--space-md);
  }

  .trip-title {
    font-size: 3rem;
    color: var(--color-text-cream);
    margin-bottom: 0;
    line-height: 0.9;
  }

  .divider { display: none; }
  
  .empty-state {
    text-align: center;
    padding: var(--space-xl);
    color: var(--color-text-muted);
    border: 2px dashed rgba(255,255,255,0.1);
  }
</style>
