
---
import Layout from '../layouts/Layout.astro';
import { getPath } from '../utils';

// Hardcoded list of verified images in public/images
const images = [
  "BonorongWildlifeSanctuaryTicketinBrighton.jpg",
  "HastingsCaves_2018_0337-1024x768.jpg",
  "Tahune-Airwalk-Supplied-Courtesy-of-Forestry-Tasmania-129788.jpg",
  "arthur-river-lodge-2.jpg", "arthur-river-lodge-5.jpg", "arthur-river-lodge.jpg",
  "bay_of_fires.jpg",
  "david-clode-3xFaGY8CjFM-unsplash.jpg", "david-clode-XMnQnYND9JU-unsplash.jpg",
  "donovan-simpkin-CXLTA4-TKxM-unsplash.jpg",
  "fidel-fernando-NCnzOZDvtP0-unsplash.jpg",
  "hastings-cave.webp",
  "haven-on-high-2.webp", "haven-on-high-3.webp", "haven-on-high.jpeg",
  "iron-blow-lookout.jpg",
  "jordan-redshaw-V6vUX8cHjSM-unsplash.jpg",
  "laura-barry-HxjKuSna5Eo-unsplash.jpg",
  "matt-palmer-Hdkca4MmA58-unsplash.jpg",
  "michael-jerrard-mnHs4boXT_0-unsplash.jpg",
  "salamanca-market-book-cover.jpg",
  "sean-robertson-pYDR8iOj0cE-unsplash.jpg",
  "stephen-mabbs-_DlwNohdZ4c-unsplash.jpg",
  "tahune-airwalks.jpg",
  "the-barn-2.jpeg", "the-barn-3.jpeg", "the-barn-4.jpeg", "the-barn.webp",
  "wineglass_bay.jpg"
].map(name => getPath(`/images/${name}`));

---

<Layout title="Gallery | Tassy Crew 2026">
  <div class="gallery-page">
    <div class="header-section text-center">
        <h1 class="page-title scroll-reveal">VISUAL EVIDENCE</h1>
        <span class="eyebrow scroll-reveal">PHOTO ARCHIVE</span>
    </div>

    <div class="gallery-grid container">
      {images.map((img, index) => (
        <div class="gallery-item scroll-reveal" onclick={`openModal('${img}')`}>
          <img src={img} alt="Gallery Image" loading="lazy" />
        </div>
      ))}
    </div>
    
    <!-- Lightbox Modal -->
    <div id="lightbox" class="lightbox" onclick="closeModal()">
        <span class="close-btn">&times;</span>
        <img class="lightbox-content" id="lightbox-img" />
    </div>
  </div>
</Layout>

<script is:inline>
  function openModal(src) {
    const modal = document.getElementById('lightbox');
    const modalImg = document.getElementById('lightbox-img');
    modal.style.display = "flex";
    modalImg.src = src;
  }

  function closeModal() {
    document.getElementById('lightbox').style.display = "none";
  }
</script>

<style>
  .gallery-page {
    background-color: var(--color-bg-dark);
    min-height: 100vh;
    padding-bottom: var(--space-xl);
  }

  .header-section {
    padding: var(--space-lg) var(--space-md);
    margin-bottom: var(--space-lg);
    border-bottom: 2px solid var(--color-accent-gold);
  }

  .page-title {
    font-size: clamp(3rem, 6vw, 6rem);
    color: var(--color-text-cream);
    margin: 0;
    line-height: 0.9;
  }
  
  .eyebrow {
    font-family: var(--font-mono);
    color: var(--color-accent-gold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--space-sm);
    padding: 0 var(--space-md);
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1; /* Square tiles */
    border-radius: 4px;
    cursor: pointer;
    border: 1px solid rgba(255,255,255,0.1);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .gallery-item:hover {
    transform: scale(1.02);
    border-color: var(--color-accent-gold);
    z-index: 2;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter 0.3s ease;
    filter: sepia(0.2) contrast(1.1);
  }
  
  .gallery-item:hover img {
    filter: none;
  }

  /* Lightbox */
  .lightbox {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.95);
    justify-content: center;
    align-items: center;
    padding: 2rem;
  }

  .lightbox-content {
    max-width: 90%;
    max-height: 90vh;
    border: 2px solid var(--color-accent-gold);
    box-shadow: 0 0 20px rgba(0,0,0,0.5);
  }

  .close-btn {
    position: absolute;
    top: 20px;
    right: 40px;
    color: #f1f1f1;
    font-size: 40px;
    font-weight: bold;
    cursor: pointer;
  }
  
  .close-btn:hover {
    color: var(--color-accent-gold);
  }
</style>
