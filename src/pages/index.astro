
---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content'; // Not used yet

const highlights = [
  { title: "Wildlife", desc: "Ontmoet de Tasmaanse Duivel, wombats en wallabies in het wild.", icon: "🦘" },
  { title: "Ruige Kust", desc: "Van Wineglass Bay tot de Bay of Fires: parelwitte stranden en oranje rotsen.", icon: "🌊" },
  { title: "Hikes", desc: "Wandel door oeroude regenwouden en beklim Cradle Mountain.", icon: "🥾" },
  { title: "Historie", desc: "Ontdek het koloniale verleden in Port Arthur en Hobart.", icon: "🏛️" },
];
---

<Layout title="Tasmanië 2026 - Rondreis">
  <main>
    <section class="hero">
      <div class="hero-content container">
        <h1>Tasmanië <span class="accent">2026</span></h1>
        <p class="subtitle">Een reis door de wildernis van het zuiden.</p>
        <div class="cta-group">
          <a href="/planning" class="btn btn-primary">Bekijk Planning</a>
          <a href="/stays" class="btn btn-secondary">Verblijven</a>
        </div>
      </div>
      <div class="hero-bg">
        <!-- Placeholder for hero image -->
        <div class="overlay"></div>
      </div>
    </section>

    <section class="intro container">
      <h2>Het Avontuur Wacht</h2>
      <p>
        Drie weken lang dompelen we ons onder in de ongerepte natuur van Tasmanië. 
        Van de bruisende markten in Hobart tot de stilte van de Tarkine Wilderness. 
        Dit platform is onze gids: planning, slaapplekken en vluchten op één plek.
      </p>
    </section>

    <section class="highlights container">
      <div class="grid">
        {highlights.map(h => (
          <div class="card">
            <div class="icon">{h.icon}</div>
            <h3>{h.title}</h3>
            <p>{h.desc}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero {
    position: relative;
    height: 80vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    color: white;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: url('https://images.unsplash.com/photo-1510019623630-6750438cf54f?q=80&w=2072&auto=format&fit=crop'); /* Placeholder */
    background-size: cover;
    background-position: center;
  }
  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.3), rgba(0,0,0,0.7));
  }
  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    width: 100%;
  }
  h1 {
    font-size: clamp(3rem, 10vw, 6rem);
    margin-bottom: var(--space-xs);
    letter-spacing: -2px;
  }
  .accent {
    color: var(--color-sandstone);
    font-style: italic;
  }
  .subtitle {
    font-size: 1.25rem;
    margin-bottom: var(--space-md);
    opacity: 0.9;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .cta-group {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
  }
  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .btn-primary {
    background: var(--color-ocean);
    color: white;
  }
  .btn-secondary {
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(5px);
    color: white;
    border: 1px solid rgba(255,255,255,0.4);
  }

  .intro {
    padding: var(--space-xl) var(--space-sm);
    text-align: center;
  }
  .intro p {
    font-size: 1.25rem;
    line-height: 1.8;
    color: var(--color-text-light);
    max-width: 800px;
    margin: var(--space-md) auto 0;
  }

  .highlights {
    padding-bottom: var(--space-xl);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-md);
  }
  .card {
    background: white;
    padding: var(--space-md);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    text-align: center;
    transition: transform 0.2s;
    border: 1px solid var(--color-mist);
  }
  .card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-ocean-light);
  }
  .icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-sm);
  }
  h3 {
    margin-bottom: var(--space-xs);
    color: var(--color-forest);
  }
  .card p {
    color: var(--color-text-light);
    font-size: 0.95rem;
  }
</style>
