---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations, useLocalizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const lp = useLocalizedPath(lang);

const blocks = [
  {
    title: t('home.blocks.trip.title'),
    subtitle: t('home.blocks.trip.subtitle'),
    desc: t('home.blocks.trip.desc'),
    link: "/planning",
    image: "/tassy_2026/images/wineglass_bay.jpg", 
    color: "var(--color-accent-gold)",
    cta: t('home.blocks.trip.cta')
  },
  {
    title: t('home.blocks.stays.title'),
    subtitle: t('home.blocks.stays.subtitle'),
    desc: t('home.blocks.stays.desc'),
    link: "/stays",
    image: "/tassy_2026/images/treetops1.avif", 
    color: "var(--color-accent-blue)",
    cta: t('home.blocks.stays.cta')
  },
  {
    title: t('home.blocks.flights.title'),
    subtitle: t('home.blocks.flights.subtitle'),
    desc: t('home.blocks.flights.desc'),
    link: "/flights",
    image: "/tassy_2026/images/launceston-airport.jpg", 
    color: "var(--color-accent-rust)",
    cta: t('home.blocks.flights.cta')
  }
];
---

<Layout title={`Tasmanië 2026 | WILDERNESS RAILWAY`}>
  <main>
    <section class="hero-industrial">
      <div class="hero-content container">
        <h1 class="hero-title scroll-reveal">
          <span class="line-1">{t('home.hero.title1')}</span>
          <span class="line-2">{t('home.hero.title2')}</span>
          <span class="line-3">{t('home.hero.title3')}</span>
          <span class="line-4">{t('home.hero.title4')}</span>
        </h1>
        <div class="hero-cta scroll-reveal">
           <a href={lp('/planning')} class="btn btn-primary">{t('home.hero.cta')}</a>
        </div>
      </div>
      <div class="hero-grain"></div>
    </section>

    <section class="poster-grid container">
      {blocks.map(block => (
        <a href={lp(block.link)} class="poster-card scroll-reveal" style={`--card-accent: ${block.color}`}>
          <div class="poster-header" style={`background-color: ${block.color}`}>
            <span class="poster-subtitle">{block.subtitle}</span>
            <h3 class="poster-title">{block.title}</h3>
          </div>
          <div class="poster-image">
            <img src={block.image} alt={block.title} loading="lazy" />
          </div>
          <div class="poster-body">
            <p>{block.desc}</p>
            <span class="poster-cta">{block.cta} &rarr;</span>
          </div>
        </a>
      ))}
    </section>

    <section class="quote-block container text-center scroll-reveal">
      <p class="quote-text">{t('home.quote.text')}</p>
      <span class="quote-source">{t('home.quote.source')}</span>
    </section>
  </main>
</Layout>

<style>
  /* Hero Industrial */
  .hero-industrial {
    background-color: var(--color-bg-dark);
    color: var(--color-text-cream);
    padding: var(--space-xl) 0;
    position: relative;
    overflow: hidden;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-grain { /* Quick texture overlay */
    position: absolute;
    inset: 0;
    opacity: 0.05;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 0.85;
    margin-bottom: var(--space-lg);
  }

  .line-1, .line-4 {
    font-size: clamp(3rem, 6vw, 5rem);
    color: transparent;
    -webkit-text-stroke: 2px var(--color-text-cream); /* Hollow text effect */
    letter-spacing: 0.1em;
  }
  
  .line-2, .line-3 {
    font-size: clamp(4rem, 9vw, 8rem);
    color: var(--color-text-cream); /* Solid text */
    letter-spacing: 0.02em;
  }
  
  .line-3 {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  .line-4 {
    color: var(--color-accent-gold);
    -webkit-text-stroke: 0; /* Solid Gold */
    font-size: clamp(3rem, 7vw, 6rem);
  }

  /* Poster Grid */
  .poster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-md);
    padding-bottom: var(--space-xl);
  }

  .poster-card {
    background-color: var(--color-bg-card);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease;
    border: 2px solid transparent; /* Prepare for hover */
  }

  .poster-card:hover {
    transform: translateY(-10px);
    border-color: var(--card-accent);
  }

  .poster-header {
    padding: var(--space-md);
    color: var(--color-bg-dark); /* Dark text on colored bg */
  }

  .poster-subtitle {
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.5rem;
    opacity: 0.8;
  }

  .poster-title {
    font-size: 2.5rem;
    color: var(--color-bg-dark);
    margin: 0;
    line-height: 0.9;
    text-shadow: none; /* Override default */
  }

  .poster-image {
    height: 250px;
    overflow: hidden;
    filter: sepia(0.3) contrast(1.1); /* Vintage look */
    transition: filter 0.3s;
  }
  
  .poster-card:hover .poster-image {
    filter: none;
  }

  .poster-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .poster-body {
    padding: var(--space-md);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .poster-body p {
    font-size: 1.1rem;
    line-height: 1.5;
    margin-bottom: var(--space-md);
    color: var(--color-text-cream);
  }

  .poster-cta {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 1.2rem;
    color: var(--card-accent);
  }
  
  /* Quote Block */
  .quote-block {
    padding: var(--space-xl) 0;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  
  .quote-text {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 800;
    color: var(--color-accent-gold);
    line-height: 1;
    margin: 0 auto var(--space-md);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .quote-source {
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--color-text-muted);
    letter-spacing: 0.2em;
    font-size: 0.9rem;
  }
</style>
