
---
import Layout from '../layouts/Layout.astro';

const blocks = [
  {
    title: "De Planning",
    subtitle: "Route & Schema",
    desc: "Een tocht van drie weken langs de hoogtepunten van het eiland. Van dag tot dag uitgestippeld.",
    link: "/planning",
    image: "https://images.unsplash.com/photo-1549608276-5786777e6587?q=80&w=2070&auto=format&fit=crop", // Map/Compass/Route feel
    cta: "Bekijk Schema"
  },
  {
    title: "Verblijven",
    subtitle: "Overnachten",
    desc: "Unieke locaties in de wildernis. Van historische cottages tot moderne cabins met uitzicht.",
    link: "/stays",
    image: "https://images.unsplash.com/photo-1449156493391-d2cfa28e468b?q=80&w=2000&auto=format&fit=crop", // Cabin/Cozy
    cta: "Ontdek Plekken"
  },
  {
    title: "Vliegreis",
    subtitle: "Logistiek",
    desc: "Vluchtnummers, tijden en overstappen. Alles wat je moet weten voor vertrek.",
    link: "/flights",
    image: "https://images.unsplash.com/photo-1436491865332-7a61a109cc05?q=80&w=2074&auto=format&fit=crop", // Wing/Clouds
    cta: "Vluchtinfo"
  }
];
---

<Layout title="Tasmanië 2026 | The Wilderness Journey">
  <main>
    <section class="hero-fullscreen">
      <div class="hero-overlay"></div>
      <div class="hero-content container">
        <span class="hero-eyebrow scroll-reveal">15 Dec 2026 — 08 Jan 2027</span>
        <h1 class="hero-title scroll-reveal">The Wilderness Journey</h1>
        <p class="hero-lead scroll-reveal">
          Een ontdekkingsreis door het ruige hart van Tasmanië. 
          Oeroude regenwouden, verlaten mijndorpen en de ongetemde oceaan.
        </p>
        <div class="hero-actions scroll-reveal">
          <a href="/planning" class="btn btn-primary">Start de Reis</a>
        </div>
      </div>
    </section>

    <section class="intro-block container text-center">
      <h2 class="section-title">Welkom in Tasmanië</h2>
      <p class="section-text">
        Dit is het digitale logboek voor onze rondreis. Hier vind je alle details
        over de route, de overnachtingen en praktische zaken. 
        Geïnspireerd door de pioniers van weleer.
      </p>
      <div class="divider-icon">✦</div>
    </section>

    <section class="nav-blocks container">
      {blocks.map(block => (
        <article class="nav-card scroll-reveal">
          <div class="card-image">
            <img src={block.image} alt={block.title} loading="lazy" />
          </div>
          <div class="card-body">
            <span class="card-subtitle">{block.subtitle}</span>
            <h3 class="card-title">{block.title}</h3>
            <p class="card-text">{block.desc}</p>
            <a href={block.link} class="btn-text">{block.cta} &rarr;</a>
          </div>
        </article>
      ))}
    </section>
  </main>
</Layout>

<style>
  /* Hero */
  .hero-fullscreen {
    position: relative;
    height: 90vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    background-image: url('https://images.unsplash.com/photo-1543292723-863ac340d869?q=80&w=2070&auto=format&fit=crop'); /* Misty Train/Forest vibe */
    background-size: cover;
    background-position: center;
    color: var(--color-white);
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(27, 59, 54, 0.3), rgba(27, 59, 54, 0.8));
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 800px; /* Constrain width */
    margin: 0 auto;
  }

  .hero-eyebrow {
    display: block;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-heritage-rust);
    margin-bottom: var(--space-sm);
    font-weight: 700;
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 5rem);
    color: var(--color-white);
    margin-bottom: var(--space-md);
    text-shadow: 0 4px 12px rgba(0,0,0,0.3);
    line-height: 1.1;
  }

  .hero-lead {
    font-size: 1.25rem;
    line-height: 1.6;
    margin-bottom: var(--space-lg);
    opacity: 0.9;
    font-weight: 300;
  }

  /* Intro */
  .intro-block {
    padding: var(--space-xl) var(--space-md);
  }

  .section-text {
    font-size: 1.1rem;
    color: var(--color-text-light);
    max-width: 600px;
    margin: 0 auto;
  }

  .divider-icon {
    margin-top: var(--space-md);
    font-size: 1.5rem;
    color: var(--color-heritage-rust);
  }

  /* Nav Blocks */
  .nav-blocks {
    padding-bottom: var(--space-xl);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-lg);
  }

  .nav-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .nav-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-hover);
    border-color: var(--color-heritage-rust);
  }

  .card-image {
    height: 240px;
    overflow: hidden;
    background-color: var(--color-paper-dark);
  }
  
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .nav-card:hover .card-image img {
    transform: scale(1.05);
  }

  .card-body {
    padding: var(--space-md);
    text-align: center;
  }

  .card-subtitle {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-stone);
    margin-bottom: var(--space-xs);
    font-weight: 700;
  }

  .card-title {
    font-size: 1.5rem;
    color: var(--color-wilderness);
    margin-bottom: var(--space-sm);
  }

  .card-text {
    font-size: 0.95rem;
    color: var(--color-text-light);
    margin-bottom: var(--space-md);
    line-height: 1.6;
  }
</style>
