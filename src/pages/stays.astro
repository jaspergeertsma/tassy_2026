
---
import Layout from '../layouts/Layout.astro';
import StayCard from '../components/StayCard.astro';
import Map from '../components/Map.tsx';
import staysData from '../data/stays.json';
import type { Stay } from '../types';

const stays: Stay[] = staysData as Stay[];
---

<Layout title="Verblijven | Tasmanië 2026">
  <main class="stays-page">
    <section class="hero-section text-center container">
      <span class="eyebrow">Accommodaties</span>
      <h1>Overnachten in Stijl</h1>
      <p>Van knusse cottages in de bergen tot beach houses aan de oostkust.</p>
    </section>

    <div class="map-container container">
      <div class="map-frame">
        <Map client:only="react" stays={stays} />
        <div class="map-overlay">
           <span class="icon">📍</span>
           <span>Interactieve Kaart</span>
        </div>
      </div>
    </div>

    <section class="stays-grid container">
      {stays.length > 0 ? (
        stays.map(stay => <StayCard stay={stay} />)
      ) : (
        <div class="empty-state">
          <p>Nog geen verblijven ingevoerd.</p>
        </div>
      )}
    </section>
  </main>
</Layout>

<style>
  .stays-page {
    background-color: var(--color-bg-dark);
    min-height: 100vh;
    padding-bottom: var(--space-xl);
  }

  .hero-section {
    padding: var(--space-lg) var(--space-md);
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-accent-blue);
    display: block;
    margin-bottom: var(--space-xs);
  }
  
  .map-container {
    margin-bottom: var(--space-lg);
  }

  .map-frame {
    height: 500px;
    width: 100%;
    border-radius: var(--radius-sm);
    overflow: hidden;
    position: relative;
    border: 2px solid rgba(255,255,255,0.1);
  }

  .map-overlay {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    background-color: var(--color-bg-dark);
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-text-muted);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-cream);
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }


  .stays-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-md);
  }
  
  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--space-xl);
    color: var(--color-stone);
    border: 2px dashed var(--color-border); 
    border-radius: var(--radius-md);
  }
</style>
