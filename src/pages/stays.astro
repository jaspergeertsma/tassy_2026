
---
import Layout from '../layouts/Layout.astro';
import StayCard from '../components/StayCard.astro';
import Map from '../components/Map.tsx';
import staysData from '../data/stays.json';

// Type checking imports
import type { Stay } from '../types';

const stays: Stay[] = staysData as Stay[];
---

<Layout title="Tasmanië 2026 - Verblijven">
  <main class="stays-page">
    <section class="map-section">
      <div class="container container-map">
        <h2>Kaart & Verblijven</h2>
        <div class="map-wrapper">
             <Map client:only="react" stays={stays} />
        </div>
      </div>
    </section>

    <section class="stays-grid container">
      {stays.length > 0 ? (
        stays.map(stay => <StayCard stay={stay} />)
      ) : (
        <p class="empty-state">Geen verblijven gevonden. Controleer de data.</p>
      )}
    </section>
  </main>
</Layout>

<style>
  .stays-page {
    background: var(--color-mist);
    min-height: 100vh;
    padding-bottom: var(--space-xl);
  }

  .map-section {
    background: white;
    padding: var(--space-md) 0;
    margin-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-mist);
  }

  .container-map {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .map-wrapper {
    height: 500px; /* Fixed height for map */
    width: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-mist);
  }

  h2 {
    color: var(--color-forest-dark);
    margin-bottom: var(--space-sm);
  }

  .stays-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-md);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-xl);
    color: var(--color-text-light);
  }
</style>
