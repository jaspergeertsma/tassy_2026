
---
import Layout from '../layouts/Layout.astro';
import TimelineDay from '../components/TimelineDay.astro';
import itineraryData from '../data/itinerary.json';

// Group by Region? Or just list
const days = itineraryData;
---

<Layout title="Reisplanning | Tasmanië 2026">
  <main class="planning-page">
    <div class="page-header container">
      <span class="eyebrow">Het Reisschema</span>
      <h1>Jouw Reis door de Wildernis</h1>
      <p class="intro-text">
        Een reis van drie weken dwars door Tasmanië. Van de oostkust met zijn witte stranden
        tot de ruige bergen in het westen. Elke dag is een nieuw hoofdstuk.
      </p>
    </div>

    <div class="layout-grid container">
      <aside class="sidebar">
        <nav class="toc-nav">
          <h3 class="toc-title">Dagen</h3>
          <ul class="toc-list">
            {days.map(day => (
              <li>
                <a href={`#day-${day.dayNumber}`} class="toc-link">
                  <span class="day-num">{String(day.dayNumber).padStart(2, '0')}</span>
                  <span class="day-label">{day.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>

      <div class="content-col">
        {days.map(day => (
          <TimelineDay day={day} />
        ))}
      </div>
    </div>
  </main>
</Layout>

<style>
  .planning-page {
    background-color: var(--color-paper);
    min-height: 100vh;
    padding-bottom: var(--space-xl);
  }

  .page-header {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-lg);
    text-align: center;
  }

  .eyebrow {
    display: block;
    font-family: var(--font-body);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-heritage-rust);
    margin-bottom: var(--space-xs);
    font-weight: 700;
  }

  .intro-text {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-text-light);
    max-width: 600px;
    margin: 0 auto;
    font-style: italic;
  }

  .layout-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 240px 1fr;
  }

  .sidebar {
    display: none;
  }

  .toc-nav {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    background-color: var(--color-white);
    padding: var(--space-md);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    max-height: 80vh;
    overflow-y: auto;
  }

  .toc-title {
    font-size: 1rem;
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 2px solid var(--color-wilderness);
  }

  .toc-list {
    list-style: none;
  }

  .toc-link {
    display: flex;
    gap: var(--space-sm);
    padding: 0.5rem 0;
    color: var(--color-text-light);
    font-size: 0.9rem;
    border-bottom: 1px solid transparent;
    transition: all 0.2s;
  }

  .toc-link:hover {
    color: var(--color-heritage-rust);
    transform: translateX(2px);
  }

  .day-num {
    font-family: var(--font-mono);
    color: var(--color-stone);
    font-size: 0.8rem;
  }

  .day-label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (min-width: 1024px) {
    .sidebar {
      display: block;
    }
  }

  @media (max-width: 1023px) {
    .layout-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
