
---
import Layout from '../layouts/Layout.astro';
import TimelineDay from '../components/TimelineDay.astro';
import itineraryData from '../data/itinerary.json';

// Group by Region? Or just list
const days = itineraryData;
---

<Layout title="Reisplanning | Tasmanië 2026">
  <main class="planning-page">
    <div class="page-header container">
      <span class="eyebrow">Het Reisschema</span>
      <h1>Jouw Reis door de Wildernis</h1>
      <p class="intro-text">
        Een reis van drie weken dwars door Tasmanië. Van de oostkust met zijn witte stranden
        tot de ruige bergen in het westen. Elke dag is een nieuw hoofdstuk.
      </p>
    </div>

    <div class="layout-grid container">
      <aside class="sidebar">
        <nav class="toc-nav">
          <h3 class="toc-title">Dagen</h3>
          <ul class="toc-list">
            {days.map(day => (
              <li>
                <a href={`#day-${day.dayNumber}`} class="toc-link">
                  <span class="day-num">{String(day.dayNumber).padStart(2, '0')}</span>
                  <span class="day-label">{day.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>

      <div class="content-col">
        {days.map(day => (
          <TimelineDay day={day} />
        ))}
      </div>
    </div>
    <!-- Lightbox Modal -->
    <div id="planning-lightbox" class="lightbox">
        <span class="close-btn">&times;</span>
        <img class="lightbox-content" id="lightbox-img" />
    </div>
  </main>
</Layout>

<script>
  // Simple Lightbox Logic
  const lightbox = document.getElementById('planning-lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const closeBtn = document.querySelector('.lightbox .close-btn');

  if (lightbox && lightboxImg && closeBtn) {
    // Event delegation for dynamically added content if any, or just static list
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (target.classList.contains('lightbox-trigger')) {
        lightbox.style.display = "flex";
        lightboxImg.src = target.src;
      }
    });

    closeBtn.addEventListener('click', () => {
      lightbox.style.display = "none";
    });

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        lightbox.style.display = "none";
      }
    });
  }

  // Scroll Spy & Smooth Scroll
  const tocLinks = document.querySelectorAll('.toc-link');
  const dayElements = document.querySelectorAll('[id^="day-"]');

  // Smooth scroll on sidebar click
  tocLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = link.getAttribute('href').substring(1);
      const targetElement = document.getElementById(targetId);
      
      if (targetElement) {
        const headerOffset = 100; // Offset for sticky header
        const elementPosition = targetElement.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

        window.scrollTo({
          top: offsetPosition,
          behavior: 'smooth'
        });
      }
    });
  });

  // Scroll spy to highlight active item
  function updateActiveLink() {
    const scrollPos = window.scrollY + 150; // Offset for header

    let currentDay = null;

    dayElements.forEach(day => {
      const dayTop = day.offsetTop;
      const dayBottom = dayTop + day.offsetHeight;

      if (scrollPos >= dayTop && scrollPos < dayBottom) {
        currentDay = day.id;
      }
    });

    // Update active class
    tocLinks.forEach(link => {
      const href = link.getAttribute('href').substring(1);
      if (href === currentDay) {
        link.classList.add('active');
      } else {
        link.classList.remove('active');
      }
    });
  }

  // Run on scroll with throttle
  let scrollTimeout;
  window.addEventListener('scroll', () => {
    if (scrollTimeout) {
      window.cancelAnimationFrame(scrollTimeout);
    }
    scrollTimeout = window.requestAnimationFrame(() => {
      updateActiveLink();
    });
  });

  // Initial check
  updateActiveLink();
</script>

<style>
  .planning-page {
    background-color: var(--color-bg-dark); /* Dark background */
    min-height: 100vh;
    padding-bottom: var(--space-xl);
  }

  .page-header {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-lg);
    text-align: center;
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-accent-gold);
    display: block;
    margin-bottom: var(--space-xs);
  }

  .intro-text {
    font-family: var(--font-body);
    font-size: 1.25rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .layout-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 340px 1fr; /* Widened by 100px */
  }

  .toc-nav {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    background-color: var(--color-bg-card);
    padding: var(--space-md);
    border: 1px solid rgba(255,255,255,0.05);
  }
  
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .toc-title {
    font-size: 1.25rem;
    color: var(--color-text-cream);
    margin-bottom: var(--space-sm);
    border-bottom: 2px solid var(--color-accent-blue);
    padding-bottom: 0.5rem;
  }

  .toc-link {
    display: flex;
    gap: var(--space-sm);
    padding: 0.5rem 0;
    color: var(--color-text-muted);
    transition: all 0.2s;
  }

  .toc-link:hover {
    color: var(--color-accent-gold);
    transform: translateX(4px);
  }

  .toc-link.active {
    color: var(--color-accent-gold);
    background: rgba(212, 160, 61, 0.1);
    border-left: 3px solid var(--color-accent-gold);
    padding-left: 0.75rem;
    margin-left: -0.75rem;
  }

  .toc-link.active .day-num {
    color: var(--color-accent-gold);
    font-weight: 600;
  }

  .toc-link.active .day-label {
    color: var(--color-text-cream);
    font-weight: 500;
  }
  
  .day-num { color: var(--color-accent-blue); font-family: var(--font-mono); }


  .day-label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (min-width: 1024px) {
    .sidebar {
      display: block;
    }
  }

  @media (max-width: 1023px) {
    .layout-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Lightbox */
  .lightbox {
    display: none;
    position: fixed;
    z-index: 2000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.95);
    justify-content: center;
    align-items: center;
    padding: 2rem;
  }

  .lightbox-content {
    max-width: 90%;
    max-height: 90vh;
    border: 2px solid var(--color-accent-gold);
    box-shadow: 0 0 20px rgba(0,0,0,0.5);
  }

  .close-btn {
    position: absolute;
    top: 20px;
    right: 40px;
    color: #f1f1f1;
    font-size: 40px;
    font-weight: bold;
    cursor: pointer;
  }
  
  .close-btn:hover {
    color: var(--color-accent-gold);
  }
</style>
