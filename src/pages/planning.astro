
---
import Layout from '../layouts/Layout.astro';
import TimelineDay from '../components/TimelineDay.astro';
import itineraryData from '../data/itinerary.json';

// Group by Region? Or just list
const days = itineraryData;
---

<Layout title="Reisplanning | Tasmanië 2026">
  <main class="planning-page">
    <div class="page-header container">
      <span class="eyebrow">Het Reisschema</span>
      <h1>Jouw Reis door de Wildernis</h1>
      <p class="intro-text">
        Een reis van drie weken dwars door Tasmanië. Van de oostkust met zijn witte stranden
        tot de ruige bergen in het westen. Elke dag is een nieuw hoofdstuk.
      </p>
    </div>

    <div class="layout-grid container">
      <aside class="sidebar">
        <nav class="toc-nav">
          <h3 class="toc-title">Dagen</h3>
          <ul class="toc-list">
            {days.map(day => (
              <li>
                <a href={`#day-${day.dayNumber}`} class="toc-link">
                  <span class="day-num">{String(day.dayNumber).padStart(2, '0')}</span>
                  <span class="day-label">{day.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>

      <div class="content-col">
        {days.map(day => (
          <TimelineDay day={day} />
        ))}
      </div>
    </div>
  </main>
</Layout>

<style>
  .planning-page {
    background-color: var(--color-bg-dark); /* Dark background */
    min-height: 100vh;
    padding-bottom: var(--space-xl);
  }

  .page-header {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-lg);
    text-align: center;
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-accent-gold);
    display: block;
    margin-bottom: var(--space-xs);
  }

  .intro-text {
    font-family: var(--font-body);
    font-size: 1.25rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .layout-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 340px 1fr; /* Widened by 100px */
  }

  .toc-nav {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    background-color: var(--color-bg-card);
    padding: var(--space-md);
    border: 1px solid rgba(255,255,255,0.05);
  }
  
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .toc-title {
    font-size: 1.25rem;
    color: var(--color-text-cream);
    margin-bottom: var(--space-sm);
    border-bottom: 2px solid var(--color-accent-blue);
    padding-bottom: 0.5rem;
  }

  .toc-link {
    display: flex;
    gap: var(--space-sm);
    padding: 0.5rem 0;
    color: var(--color-text-muted);
    transition: all 0.2s;
  }

  .toc-link:hover {
    color: var(--color-accent-gold);
    transform: translateX(4px);
  }
  
  .day-num { color: var(--color-accent-blue); font-family: var(--font-mono); }


  .day-label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (min-width: 1024px) {
    .sidebar {
      display: block;
    }
  }

  @media (max-width: 1023px) {
    .layout-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
