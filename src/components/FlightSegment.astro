
---
import type { FlightSegment } from '../types';

interface Props {
  segment: FlightSegment;
  isLast?: boolean;
}

const { segment, isLast } = Astro.props;
---

<div class="segment scroll-reveal">
  <div class="time-col">
    <div class="time-block">
      <span class="time">{segment.departLocal}</span>
      <span class="location-code">{segment.from}</span>
    </div>
    
    <div class="duration-line">
       <span class="duration-text">{segment.duration}</span>
    </div>

    <div class="time-block arrival">
      <span class="time">{segment.arriveLocal}</span>
      <span class="location-code">{segment.to}</span>
    </div>
  </div>
  
  <div class="graphic-col">
    <div class="dot departing"></div>
    <div class="path-line"></div>
    <div class="dot arriving"></div>
  </div>

  <div class="info-card">
    <div class="card-header">
       <span class="airline">{segment.airline}</span>
       <span class="flight-no">{segment.flightNo}</span>
    </div>
    <div class="card-details">
       <div class="detail-row">
         <span class="label">Date</span>
         <span class="value">{new Date(segment.date).toLocaleDateString()}</span>
       </div>
    </div>
  </div>
</div>

<style>
  .segment {
    display: grid;
    grid-template-columns: 100px 24px 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    position: relative;
  }
  
  /* Time Column */
  .time-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-align: right;
    padding: var(--space-xs) 0;
    font-family: var(--font-mono);
  }

  .time {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-accent-gold);
    line-height: 1;
  }

  .location-code {
    display: block;
    font-size: 1rem;
    color: var(--color-text-cream);
    font-weight: 700;
  }
  
  .duration-text {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background: rgba(255,255,255,0.05);
    padding: 2px 4px;
    border-radius: 2px;
  }
  
  /* Graphic Column */
  .graphic-col {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: var(--color-bg-dark);
    border: 3px solid var(--color-accent-rust);
    z-index: 2;
  }
  
  .path-line {
    flex-grow: 1;
    width: 2px;
    background-color: var(--color-text-muted);
    margin: 4px 0;
    opacity: 0.3;
    border-left: 2px dashed rgba(255,255,255,0.2);
    background: transparent;
  }

  /* Info Card */
  .info-card {
    background-color: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--radius-sm);
    padding: var(--space-md);
    transition: transform 0.3s ease;
  }
  
  .info-card:hover {
    transform: translateX(4px);
    border-color: var(--color-accent-gold);
    background-color: rgba(255,255,255,0.05);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid rgba(255,255,255,0.1);
    padding-bottom: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .airline {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-text-cream);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .flight-no {
    font-family: var(--font-mono);
    color: var(--color-accent-blue);
    font-size: 1rem;
    font-weight: 700;
  }

  .detail-row {
    display: flex;
    gap: var(--space-sm);
    font-size: 0.9rem;
    font-family: var(--font-mono);
  }
  
  .label {
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  
  .value {
    color: var(--color-text-cream);
  }

  @media (max-width: 600px) {
    .segment {
      grid-template-columns: 80px 20px 1fr;
      gap: var(--space-sm);
    }
    .time { font-size: 1.2rem; }
  }
</style>
