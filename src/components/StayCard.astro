
---
import type { Stay } from '../types';

interface Props {
  stay: Stay;
}

const { stay } = Astro.props;
---

<article class="stay-card scroll-reveal">
  <div class="image-wrapper">
    <img src={stay.images?.[0] || 'https://images.unsplash.com/photo-1542718610-a1d656d1884c?q=80&w=2070&auto=format&fit=crop'} alt={stay.name} loading="lazy" />
  </div>
  
  <div class="content">
    <header class="card-header">
      <span class="region-label">{stay.region || 'Tasmanië'}</span>
      <h3 class="stay-title">{stay.name}</h3>
      <p class="location-details">{stay.location}</p>
    </header>

    <div class="meta-row">
      <div class="meta-item">
        <span class="icon">📅</span>
        <span>{new Date(stay.checkIn).toLocaleDateString('nl-NL', { day: 'numeric', month: 'short' })}</span>
        {stay.checkOut && (
           <span class="range-sep">—</span>
           <span>{new Date(stay.checkOut).toLocaleDateString('nl-NL', { day: 'numeric', month: 'short' })}</span>
        )}
      </div>
      {stay.price && (
        <div class="meta-item price">
            {stay.price}
        </div>
      )}
    </div>
    
    <div class="actions">
       {stay.link ? (
         <a href={stay.link} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-full">Bekijk Details</a>
       ) : (
         <span class="btn btn-disabled btn-full">Geen link beschikbaar</span>
       )}
    </div>
  </div>
</article>

<style>
  .stay-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .stay-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--color-wilderness-light);
  }

  .image-wrapper {
    position: relative;
    padding-top: 66.66%; /* 3:2 Aspect Ratio */
    background-color: var(--color-paper-dark);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .image-wrapper img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  .stay-card:hover .image-wrapper img {
    transform: scale(1.03);
  }

  .content {
    padding: var(--space-md);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .card-header {
    margin-bottom: var(--space-md);
  }

  .region-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-heritage-rust);
    margin-bottom: var(--space-xs);
  }

  .stay-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-wilderness);
    margin-bottom: 0.25rem;
    line-height: 1.2;
  }

  .location-details {
    font-size: 0.95rem;
    color: var(--color-stone);
    font-style: italic;
  }

  .meta-row {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-text-light);
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-sm);
    margin-top: auto; /* Push to bottom */
    margin-bottom: var(--space-md);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .icon { font-size: 1rem; opacity: 0.7; }
  .price { font-weight: 700; color: var(--color-steam); }
  
  .btn-full {
    width: 100%;
    justify-content: center;
    font-size: 0.85rem;
    padding: 0.75rem;
  }
  
  .btn-disabled {
    background: var(--color-paper-dark);
    color: var(--color-stone);
    cursor: not-allowed;
    border: none;
  }
</style>
