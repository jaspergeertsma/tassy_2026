
---
import type { Stay } from '../types';

interface Props {
  stay: Stay;
}

const { stay } = Astro.props;
---

<article class="stay-card scroll-reveal">
  <div class="image-wrapper">
    <img src={stay.images?.[0] || 'https://images.unsplash.com/photo-1542718610-a1d656d1884c?q=80&w=2070&auto=format&fit=crop'} alt={stay.name} loading="lazy" />
    <span class="region-badge">{stay.region}</span>
  </div>
  
  <div class="content">
    <header class="card-header">
      <h3 class="stay-title">{stay.name}</h3>
      <p class="location-details">{stay.location}</p>
    </header>

    <div class="meta-row">
       <span class="dates">
         {new Date(stay.checkIn).toLocaleDateString('nl-NL', { day: 'numeric', month: 'short' })}
         {stay.checkOut && ` — ${new Date(stay.checkOut).toLocaleDateString('nl-NL', { day: 'numeric', month: 'short' })}`}
       </span>
       {stay.price && <span class="price">{stay.price}</span>}
    </div>
    
    <div class="actions">
       {stay.link ? (
         <a href={stay.link} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-full">VIEW LODGING</a>
       ) : (
         <span class="btn btn-disabled btn-full">UNAVAILABLE</span>
       )}
    </div>
  </div>
</article>

<style>
  .stay-card {
    background-color: var(--color-bg-card);
    border: 2px solid transparent;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: all 0.3s ease;
  }

  .stay-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-accent-blue);
  }

  .image-wrapper {
    position: relative;
    padding-top: 60%;
    background-color: #000;
    overflow: hidden;
  }

  .image-wrapper img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
    filter: sepia(0.2) contrast(1.1);
  }

  .stay-card:hover .image-wrapper img {
    transform: scale(1.05);
    filter: none;
  }
  
  .region-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--color-accent-gold);
    color: var(--color-bg-dark);
    font-family: var(--font-display);
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .content {
    padding: var(--space-md);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .card-header {
    margin-bottom: var(--space-md);
  }

  .stay-title {
    font-size: 1.75rem;
    line-height: 1;
    margin-bottom: 0.5rem;
    color: var(--color-text-cream);
  }

  .location-details {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: var(--space-sm);
    margin-top: auto;
    margin-bottom: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  
  .price {
    color: var(--color-accent-gold);
  }
  
  .btn-full {
    width: 100%;
    font-size: 1rem;
    padding: 0.75rem;
  }
  
  .btn-disabled {
    display: block;
    text-align: center;
    border: 1px solid var(--color-text-muted);
    color: var(--color-text-muted);
    font-family: var(--font-display);
    padding: 0.75rem;
    font-size: 1rem;
    opacity: 0.5;
  }
</style>
