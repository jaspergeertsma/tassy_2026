
---
import type { Stay } from '../types';

interface Props {
  stay: Stay;
}

const { stay } = Astro.props;
---

<article class="stay-card">
  <div class="image-wrapper">
    <img src={stay.images?.[0] || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&q=80&w=1000'} alt={stay.name} loading="lazy" />
    <span class="price-tag">{stay.price || 'Prijs op aanvraag'}</span>
  </div>
  <div class="content">
    <h3>{stay.name}</h3>
    <p class="location">📍 {stay.location || stay.region}</p>
    <div class="dates">
      <span>Check-in: {stay.checkIn}</span>
      {stay.checkOut && <span> - Check-out: {stay.checkOut}</span>}
    </div>
    
    {stay.link && (
      <a href={stay.link} target="_blank" rel="noopener noreferrer" class="btn-link">Bekijk op AirBnB &rarr;</a>
    )}
  </div>
</article>

<style>
  .stay-card {
    background: white;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s, box-shadow 0.2s;
    border: 1px solid var(--color-mist);
    display: flex;
    flex-direction: column;
  }
  .stay-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  
  .image-wrapper {
    position: relative;
    height: 200px;
    overflow: hidden;
  }
  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  .stay-card:hover .image-wrapper img {
    transform: scale(1.05);
  }
  
  .price-tag {
    position: absolute;
    bottom: var(--space-sm);
    right: var(--space-sm);
    background: rgba(0,0,0,0.7);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 500;
    backdrop-filter: blur(4px);
  }

  .content {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--color-text-main);
  }

  .location {
    color: var(--color-text-light);
    font-size: 0.9rem;
    margin-bottom: var(--space-sm);
  }

  .dates {
    font-size: 0.85rem;
    color: var(--color-forest);
    margin-bottom: var(--space-md);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .btn-link {
    margin-top: auto;
    color: var(--color-ocean);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .btn-link:hover {
    text-decoration: underline;
  }
</style>
