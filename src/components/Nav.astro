
---
import { getPath } from '../utils';

const links = [
  { href: '/planning', label: 'De Reis' },
  { href: '/route', label: 'Route' },
  { href: '/stays', label: 'Overnachten' },
  { href: '/flights', label: 'Vliegreis' },
  { href: '/gallery', label: 'Foto\'s' },
];
---

<nav class="sticky-nav">
  <div class="container nav-container">
    <a href={getPath('/')} class="logo">
      <span class="logo-top">Wilderness</span>
      <span class="logo-main">Tassy Crew</span>
      <span class="logo-bottom">Est. 2026</span>
    </a>
    
    <div class="nav-links-wrapper">
      <ul class="nav-links">
        {links.map(link => (
          <li><a href={getPath(link.href)} class="nav-item">{link.label}</a></li>
        ))}
      </ul>
      <a href="https://docs.google.com/spreadsheets/d/1JMbU7-4rmi14r_PXe24v--G61rzUL1N5bgRe7xn1B5I/edit?usp=sharing" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm desktop-only">Excel</a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button type="button" class="hamburger" aria-label="Menu" id="hamburger-btn">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

  <!-- Mobile Menu Overlay -->
  <div class="mobile-menu" id="mobile-menu">
    <div class="mobile-menu-content">
      <ul class="mobile-nav-links">
        {links.map(link => (
          <li><a href={getPath(link.href)} class="mobile-nav-item">{link.label}</a></li>
        ))}
        <li>
          <a href="https://docs.google.com/spreadsheets/d/1JMbU7-4rmi14r_PXe24v--G61rzUL1N5bgRe7xn1B5I/edit?usp=sharing" target="_blank" rel="noopener noreferrer" class="mobile-nav-item">Excel</a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  const hamburger = document.getElementById('hamburger-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  if (hamburger && mobileMenu) {
    hamburger.addEventListener('click', () => {
      hamburger.classList.toggle('active');
      mobileMenu.classList.toggle('active');
      document.body.style.overflow = mobileMenu.classList.contains('active') ? 'hidden' : '';
    });

    // Close menu on link click
    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        hamburger.classList.remove('active');
        mobileMenu.classList.remove('active');
        document.body.style.overflow = '';
      });
    });

    // Close on overlay click
    mobileMenu.addEventListener('click', (e) => {
      if (e.target === mobileMenu) {
        hamburger.classList.remove('active');
        mobileMenu.classList.remove('active');
        document.body.style.overflow = '';
      }
    });
  }
</script>

<style>
  .sticky-nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(31, 29, 27, 0.95); /* Dark background */
    backdrop-filter: blur(8px);
    border-bottom: 2px solid rgba(255,255,255,0.05);
    height: var(--header-height);
    display: flex;
    align-items: center;
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 0.9;
    color: var(--color-text-cream);
    text-transform: uppercase;
    font-family: var(--font-display);
    border: 2px solid var(--color-text-cream);
    padding: 4px 8px;
    border-radius: 2px;
  }
  
  .logo-top { font-size: 0.7rem; letter-spacing: 0.2em; }
  .logo-main { font-size: 1.5rem; font-weight: 800; letter-spacing: 0.05em; margin: 2px 0; }
  .logo-bottom { font-size: 0.7rem; letter-spacing: 0.2em; color: var(--color-accent-gold); }

  .nav-links-wrapper {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .nav-links {
    list-style: none;
    display: none;
    gap: var(--space-md);
  }

  .desktop-only {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-links { display: flex; }
    .desktop-only { display: block; }
  }

  .nav-item {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-text-cream);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .nav-item:hover {
    opacity: 1;
    color: var(--color-accent-gold);
  }
  
  .btn-outline {
    border: 1px solid var(--color-text-muted);
    padding: 0.5rem 1rem;
    color: var(--color-text-cream);
    font-size: 0.8rem;
    border-radius: 2px;
  }
  .btn-outline:hover {
    border-color: var(--color-accent-gold);
    color: var(--color-accent-gold);
  }

  /* Hamburger Button */
  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 1002;
  }

  .hamburger-line {
    width: 28px;
    height: 3px;
    background: var(--color-text-cream);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .hamburger.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .hamburger.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .hamburger.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (min-width: 768px) {
    .hamburger {
      display: none;
    }
  }

  /* Mobile Menu Overlay */
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(10px);
    z-index: 1001;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .mobile-menu.active {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
    padding: 2rem;
  }

  .mobile-nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: center;
  }

  .mobile-nav-links li {
    margin: 1.5rem 0;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.3s ease;
  }

  .mobile-menu.active .mobile-nav-links li {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger animation for menu items */
  .mobile-menu.active .mobile-nav-links li:nth-child(1) { transition-delay: 0.1s; }
  .mobile-menu.active .mobile-nav-links li:nth-child(2) { transition-delay: 0.15s; }
  .mobile-menu.active .mobile-nav-links li:nth-child(3) { transition-delay: 0.2s; }
  .mobile-menu.active .mobile-nav-links li:nth-child(4) { transition-delay: 0.25s; }
  .mobile-menu.active .mobile-nav-links li:nth-child(5) { transition-delay: 0.3s; }
  .mobile-menu.active .mobile-nav-links li:nth-child(6) { transition-delay: 0.35s; }

  .mobile-nav-item {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text-cream);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: all 0.3s ease;
    display: block;
    padding: 0.5rem;
  }

  .mobile-nav-item:hover {
    color: var(--color-accent-gold);
    transform: scale(1.1);
  }

  @media (min-width: 768px) {
    .mobile-menu {
      display: none;
    }
  }
</style>
