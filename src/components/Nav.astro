
---
import { getPath } from '../utils';

const links = [
  { href: '/planning', label: 'De Reis' },
  { href: '/stays', label: 'Overnachten' },
  { href: '/flights', label: 'Vliegreis' },
  { href: '/gallery', label: 'Foto\'s' },
];
---

<nav class="sticky-nav">
  <div class="container nav-container">
    <a href={getPath('/')} class="logo">
      <span class="logo-top">Wilderness</span>
      <span class="logo-main">Tassy Crew</span>
      <span class="logo-bottom">Est. 2026</span>
    </a>
    
    <div class="nav-links-wrapper">
      <ul class="nav-links">
        {links.map(link => (
          <li><a href={getPath(link.href)} class="nav-item">{link.label}</a></li>
        ))}
      </ul>
      <a href="https://docs.google.com/spreadsheets/d/1JMbU7-4rmi14r_PXe24v--G61rzUL1N5bgRe7xn1B5I/edit?usp=sharing" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">Excel</a>
    </div>
  </div>
</nav>

<style>
  .sticky-nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(31, 29, 27, 0.95); /* Dark background */
    backdrop-filter: blur(8px);
    border-bottom: 2px solid rgba(255,255,255,0.05);
    height: var(--header-height);
    display: flex;
    align-items: center;
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 0.9;
    color: var(--color-text-cream);
    text-transform: uppercase;
    font-family: var(--font-display);
    border: 2px solid var(--color-text-cream);
    padding: 4px 8px;
    border-radius: 2px;
  }
  
  .logo-top { font-size: 0.7rem; letter-spacing: 0.2em; }
  .logo-main { font-size: 1.5rem; font-weight: 800; letter-spacing: 0.05em; margin: 2px 0; }
  .logo-bottom { font-size: 0.7rem; letter-spacing: 0.2em; color: var(--color-accent-gold); }

  .nav-links-wrapper {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .nav-links {
    list-style: none;
    display: none;
    gap: var(--space-md);
  }

  @media (min-width: 768px) {
    .nav-links { display: flex; }
  }

  .nav-item {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-text-cream);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .nav-item:hover {
    opacity: 1;
    color: var(--color-accent-gold);
  }
  
  .btn-outline {
    border: 1px solid var(--color-text-muted);
    padding: 0.5rem 1rem;
    color: var(--color-text-cream);
    font-size: 0.8rem;
    border-radius: 2px;
  }
  .btn-outline:hover {
    border-color: var(--color-accent-gold);
    color: var(--color-accent-gold);
  }
</style>
