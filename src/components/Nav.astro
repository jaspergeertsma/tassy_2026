
---
const links = [
  { href: '/planning', label: 'Planning' },
  { href: '/stays', label: 'Overnachten' },
  { href: '/flights', label: 'Vliegreis' },
];
---

<nav class="sticky-nav">
  <div class="container nav-container">
    <a href="/" class="logo">
      <span class="logo-loc">Tasmanië</span>
      <span class="logo-year">2026</span>
    </a>
    
    <div class="nav-links-wrapper">
      <ul class="nav-links">
        {links.map(link => (
          <li><a href={link.href} class="nav-item">{link.label}</a></li>
        ))}
      </ul>
      <a href="/planning.pdf" download class="btn btn-secondary btn-sm">Download PDF</a>
    </div>
  </div>
</nav>

<style>
  .sticky-nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    height: var(--header-height);
    display: flex;
    align-items: center;
    box-shadow: 0 1px 0 rgba(0,0,0,0.02);
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .logo {
    display: flex;
    flex-direction: column;
    line-height: 1;
    color: var(--color-wilderness);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--font-display);
    transition: color 0.2s ease;
  }

  .logo:hover {
    color: var(--color-heritage-rust);
  }

  .logo-loc {
    font-size: 1.5rem;
    font-weight: 700;
  }
  
  .logo-year {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--color-stone);
    margin-top: 2px;
  }

  .nav-links-wrapper {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .nav-links {
    list-style: none;
    display: none; /* Mobile first hidden */
    gap: var(--space-md);
    margin: 0;
    padding: 0;
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-item {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-steam);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    position: relative;
    padding: 0.5rem 0;
  }

  .nav-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background-color: var(--color-heritage-rust);
    transition: width 0.3s cubic-bezier(0.2, 1, 0.2, 1);
  }

  .nav-item:hover {
    color: var(--color-heritage-rust);
  }
  
  .nav-item:hover::after {
    width: 100%;
  }

  .btn-sm {
    padding: 0.5rem 1.25rem;
    font-size: 0.8rem;
  }
</style>
