
---
import type { ItineraryDay } from '../types';

interface Props {
  day: ItineraryDay;
}

const { day } = Astro.props;

const dateObj = new Date(day.date);
const dayName = dateObj.toLocaleDateString('nl-NL', { weekday: 'long' });
const dayDate = dateObj.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long' });

const hasImages = day.images && day.images.length > 0;
---

<div class={`day-card scroll-reveal ${hasImages ? 'has-images' : ''}`} data-region={day.region}>
  <div class="date-col">
    <span class="day-number">DAG {day.dayNumber}</span>
    <span class="day-name">{dayName}</span>
    <span class="day-date">{dayDate}</span>
  </div>
  
  <div class="content-col">
    <div class="header">
      <h3>{day.title}</h3>
      <span class="region-badge">{day.region}</span>
    </div>

    {hasImages && (
      <div class="day-images">
        {day.images.map(img => (
          <div class="image-thumb">
            <img src={img} alt={day.title} loading="lazy" />
          </div>
        ))}
      </div>
    )}

    <div class="day-details">
      {day.notes && (
        <p class="description">{day.notes}</p>
      )}

      {day.activities.length > 0 && (
        <div class="activities-block">
          <ul class="activities-list">
            {day.activities.map(act => (
              <li>
                <span class="bullet">+</span>
                {act}
              </li>
            ))}
          </ul>
        </div>
      )}

      {day.drive && (
        <div class="drive-info">
          <span class="drive-label">DRIVE:</span>
          <span class="drive-val">{day.drive.km} km</span>
          <span class="sep">/</span>
          <span class="drive-val">{day.drive.time}</span>
        </div>
      )}
    </div>
  </div>
</article>

<style>
  .timeline-day {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-md);
    padding: var(--space-md);
    background-color: var(--color-bg-card);
    border: 1px solid rgba(255,255,255,0.05);
    margin-bottom: var(--space-md);
    transition: all 0.3s ease;
    scroll-margin-top: calc(var(--header-height) + 2rem);
  }

  .timeline-day:hover {
    border-color: var(--color-accent-gold);
    transform: translateX(4px);
  }

  /* Calendar Badge */
  .calendar-badge {
    background-color: rgba(0,0,0,0.2);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    padding: var(--space-sm) 0.5rem;
    height: fit-content;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .bad-month {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .bad-day {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-accent-gold);
  }

  .bad-weekday {
    font-size: 0.65rem;
    text-transform: uppercase;
    color: var(--color-text-muted);
    letter-spacing: 0.1em;
  }

  /* Content */
  .day-content {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .day-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 2px dashed rgba(255,255,255,0.1);
  }

  .day-counter {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--color-accent-blue);
    margin-bottom: 0.25rem;
    letter-spacing: 0.1em;
  }

  .day-title {
    font-size: 2rem;
    color: var(--color-text-cream);
    margin: 0;
    line-height: 1;
  }
  
  .region-pill {
    background-color: transparent;
    border: 1px solid var(--color-text-muted);
    color: var(--color-text-muted);
    padding: 0.25rem 0.75rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .description {
    font-size: 1.1rem;
    color: var(--color-text-cream);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .activities-list {
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-md);
  }

  .activities-list li {
    display: flex;
    align-items: flex-start;
    margin-bottom: 0.5rem;
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  .bullet {
    color: var(--color-accent-gold);
    margin-right: 0.75rem;
    font-weight: bold;
  }

  .drive-info {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    background: rgba(0,0,0,0.2);
    padding: 0.5rem;
    display: inline-block;
    border-radius: 2px;
  }
  
  .drive-label { color: var(--color-accent-rust); margin-right: 0.5rem; }
  .drive-val { color: var(--color-text-cream); }
  .sep { margin: 0 0.5rem; opacity: 0.5; }

  .day-images {
    display: flex;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
  }

  .image-thumb {
    width: 60px;
    height: 60px;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .image-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 600px) {
    .timeline-day { grid-template-columns: 1fr; }
    .calendar-badge { flex-direction: row; gap: 1rem; align-items: baseline; }
    .bad-day { font-size: 1.5rem; }
  }
</style>
