
---
import type { ItineraryDay } from '../types';

interface Props {
  day: ItineraryDay;
}

const { day } = Astro.props;

const dateObj = new Date(day.date);
const dayName = dateObj.toLocaleDateString('nl-NL', { weekday: 'long' });
const dayDate = dateObj.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long' });

const hasImages = day.images && day.images.length > 0;
---

<div class={`day-card scroll-reveal ${hasImages ? 'has-images' : ''}`} data-region={day.region}>
  <div class="date-col">
    <span class="day-number">DAG {day.dayNumber}</span>
    <span class="day-name">{dayName}</span>
    <span class="day-date">{dayDate}</span>
  </div>
  
  <div class="content-col">
    <div class="header">
      <h3>{day.title}</h3>
      <span class="region-badge">{day.region}</span>
    </div>

    {hasImages && (
      <div class="day-images">
        {day.images.map(img => (
          <div class="image-thumb">
            <img src={img} alt={day.title} loading="lazy" class="lightbox-trigger" />
          </div>
        ))}
      </div>
    )}

    <div class="day-details">
      {day.notes && (
        <p class="description">{day.notes}</p>
      )}

      {day.activities.length > 0 && (
        <div class="activities-block">
          <ul class="activities-list">
            {day.activities.map(act => {
              const name = typeof act === 'string' ? act : act.name;
              const url = typeof act === 'string' ? null : act.url;
              return (
                <li>
                  {url ? (
                    <a href={url} target="_blank" rel="noopener noreferrer" class="activity-link">{name}</a>
                  ) : (
                    <span>{name}</span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      )}

      {day.drive && (
        <div class="drive-info">
          <span class="drive-label">DRIVE:</span>
          <span class="drive-val">{day.drive.km} km</span>
          <span class="sep">/</span>
          <span class="drive-val">{day.drive.time}</span>
        </div>
      )}
    </div>
  </div>
</article>

<style>
  .day-card {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--space-md);
    background-color: var(--color-bg-card);
    border: 1px solid rgba(255,255,255,0.05);
    border-left: 4px solid var(--color-accent-gold);
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
    border-radius: 2px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.2);
    transition: transform 0.3s ease, border-color 0.3s ease;
    scroll-margin-top: 100px; /* offset for sticky nav */
  }

  /* Different accents for regions */
  .day-card[data-region="Campbell town"] { border-left-color: var(--color-heritage-rust); }
  .day-card[data-region="Cygnet"] { border-left-color: var(--color-accent-blue); }
  .day-card[data-region="Northwest"] { border-left-color: var(--color-accent-green); }

  .day-card:hover {
    border-color: rgba(255,255,255,0.1);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  }

  .date-col {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    border-right: 1px dashed rgba(255,255,255,0.1);
    padding-right: var(--space-md);
  }

  .day-number {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-accent-gold);
    font-weight: 800;
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .day-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    text-transform: uppercase;
    color: var(--color-text-cream);
    letter-spacing: 0.1em;
  }

  .day-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .content-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .header h3 {
    font-size: 1.75rem;
    margin: 0;
    color: var(--color-text-cream);
    line-height: 1.1;
    text-transform: uppercase;
  }

  .region-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--color-accent-blue);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 2px 8px;
    border-radius: 2px;
    white-space: nowrap;
  }

  .day-images {
    display: flex;
    gap: 0.5rem;
    margin: 0.5rem 0;
    flex-wrap: wrap;
  }

  .image-thumb {
    width: 80px;
    height: 80px;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.1);
    flex-shrink: 0;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .image-thumb:hover {
    border-color: var(--color-accent-gold);
  }

  .image-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  
  .image-thumb:hover img {
    transform: scale(1.1);
  }

  .description {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  .activities-block {
    margin-top: 0.5rem;
  }

  .activities-list {
    margin: 0;
    padding-left: 0;
    list-style: none;
  }

  .activities-list li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.25rem;
    color: var(--color-text-cream);
    font-size: 0.95rem;
  }

  .activities-list li::before {
    content: "➢";
    position: absolute;
    left: 0;
    color: var(--color-accent-rust);
    font-size: 0.8rem;
    line-height: 1.5;
  }
  
  .activity-link {
    color: var(--color-text-cream);
    text-decoration: none;
    border-bottom: 1px dotted var(--color-accent-gold);
    transition: all 0.2s;
  }

  .activity-link:hover {
    color: var(--color-accent-gold);
    border-bottom-style: solid;
  }

  .drive-info {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    background: rgba(0,0,0,0.2);
    padding: 0.5rem;
    display: inline-block;
    border-radius: 2px;
    width: fit-content;
  }
  
  .drive-label { color: var(--color-accent-rust); margin-right: 0.5rem; }
  .drive-val { color: var(--color-text-cream); }
  .sep { margin: 0 0.5rem; opacity: 0.5; }

  @media (max-width: 768px) {
    .day-card {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: var(--space-md);
    }
    
    .date-col {
      flex-direction: row;
      align-items: baseline;
      gap: 1rem;
      border-right: none;
      border-bottom: 1px dashed rgba(255,255,255,0.1);
      padding-right: 0;
      padding-bottom: 0.5rem;
    }
    
    .day-number { font-size: 1.2rem; }
    .header h3 { font-size: 1.5rem; }
  }
</style>
